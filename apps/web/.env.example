# Only ADELI_API_KEY is needed for local development. On Vercel, see "Deploy to Vercel" in README.md.

# Your Adeli API key (see "Get your Adeli API key" in README.md). Every user gets their own profile in its organization.
ADELI_API_KEY=
# Leave empty for the hosted Adeli. http://localhost:3000 for a local Adeli dev server.
ADELI_API_BASE_URL=

# Postgres connection string. Required on Vercel (the Neon integration sets it).
# Leave empty locally to use a PGlite database in ./.data.
DATABASE_URL=

# Google sign-in. Without these, local dev runs with no login.
# Deployed (Vercel or `next start`), login is always on and these are required.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that may sign in. Empty: anyone with Google can sign in and get their own workspace.
ALLOWED_EMAILS=

# Optional. Better Auth Infrastructure API key, to see your users in its dashboard (https://better-auth.com/docs/infrastructure/getting-started).
BETTER_AUTH_API_KEY=

# Optional product analytics (docs/analytics.md). Empty token: nothing is sent.
# NEXT_PUBLIC_ values are built into the page, so redeploy after changing them.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# https://us.i.posthog.com (default) or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
# https://us.posthog.com (default) or https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=

# Public URL of this install. Defaults to the Vercel production domain, or http://localhost:3030.
APP_URL=
