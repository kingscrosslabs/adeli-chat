# Adeli API. Point at a local Adeli dev server for testing.
ADELI_BASE_URL=http://localhost:3000
ADELI_API_KEY=rk_live_...

# Postgres from docker-compose.yml.
DATABASE_URL=postgres://adeli_chat:adeli_chat@localhost:35438/adeli_chat

# Keep these server-side and never commit them.
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3030
