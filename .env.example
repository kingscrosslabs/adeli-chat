# Required. Create one in Adeli under Settings > API keys (starts with rk_live_).
ADELI_API_KEY=

# Optional. Postgres connection string. Leave empty to use a local PGlite database in ./.data.
DATABASE_URL=

# Optional. Defaults to https://app.tryadeli.com. Use http://localhost:3000 for a local Adeli.
ADELI_API_BASE_URL=
