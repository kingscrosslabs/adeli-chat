# Set these to call the real Adeli API. Keep them server-side and never commit them.
# ADELI_API_KEY=rk_live_...
# ADMIN_PASSWORD=replace-with-a-strong-password
# SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000

# Optional when testing against a local Adeli checkout.
# ADELI_API_BASE_URL=http://localhost:3000/api/v1

# Use the built-in sample accounts and posts instead of the real API.
ADELI_MOCK=1
